# AI数字化人才平台环境配置模板（可提交；不得填写真实秘密后上传）
# 推荐运行 python scripts/init_env.py 自动生成项目独立 .env，已有文件不会被覆盖。
# 手工配置时复制本文件为 .env，填齐所有必填项；.env 永远不提交。
# .env.example 为兼容命名副本，两份模板须保持一致。

# ---------- 运行环境 ----------
# 当前Compose用于本地开发；不能将其直接当生产部署方案。
TALENT_ENVIRONMENT=dev

# ---------- 必填：本项目独立基础服务凭据 ----------
# 以下值由init_env生成；不要填写个人已有数据库密码。
TALENT_MYSQL_ROOT_PASSWORD=
TALENT_MYSQL_PASSWORD=
TALENT_REDIS_PASSWORD=
TALENT_MINIO_USER=
TALENT_MINIO_PASSWORD=
# 监控令牌，至少32字符；只用于受保护的依赖就绪检查。
TALENT_MONITOR_TOKEN=

# ---------- 必填：容器内连接地址 ----------
# 由init_env生成完整URL；密码含保留字符时须URL编码。
# 开发库示意：mysql+pymysql://talent:<密码>@mysql:3306/talent_dev?charset=utf8mb4
TALENT_DATABASE_URL=
# 仅测试使用：mysql+pymysql://talent:<密码>@mysql-test:3306/talent_test?charset=utf8mb4
# 测试会迁移/清空此库，禁止指向开发库或已有个人/企业数据库。
TALENT_TEST_DATABASE_URL=
# 示例结构：redis://:<密码>@redis:6379/0
TALENT_REDIS_URL=

# ---------- 对象存储与上传限制 ----------
# 容器内部地址；宿主机调试时相应改为127.0.0.1:19000。
TALENT_MINIO_ENDPOINT=minio:9000
TALENT_MINIO_BUCKET=talent-business
TALENT_MINIO_SECURE=false
# 每份文件最多20MiB、100页；后续OCR/Word验收仍按对应任务执行。
TALENT_MAX_FILE_BYTES=20971520
TALENT_MAX_FILE_PAGES=100

# ---------- 会话与跨站请求保护 ----------
TALENT_SESSION_NAMESPACE=talent:staff
# 列表必须使用JSON，不是逗号分隔字符串。
TALENT_TRUSTED_ORIGINS=["http://localhost:13000","http://127.0.0.1:13000"]

# ---------- 必填：配置加密主密钥 ----------
# init_env生成Fernet key；恢复加密数据库时必须保留同一把主密钥。
# 不可随意更换，否则数据库中已有模型/SMTP凭据将无法解密。
TALENT_ENCRYPTION_KEY=

# ---------- 可选：显式授权的官方模型凭据 ----------
# DeepSeek官方渠道，当前白名单模型deepseek-flash。留空不会自动启用AI流程。
TALENT_DEEPSEEK_API_KEY=
# 百炼北京地域，text-embedding-v3；可选qwen3-rerank按对应任务另行接入。
TALENT_DASHSCOPE_API_KEY=
# 模型地址、修订、提示词和流程启用由管理员配置，不虚构未读取的环境变量。
# 七个固定AI流程默认关闭；合成调用可能产生供应商费用，须显式运行。

# ---------- 邮件主机白名单 ----------
# 本地只连接Mailpit，不向真实邮箱投递。
TALENT_ALLOWED_SMTP_HOSTS=["mailpit"]
# SMTP地址、端口、用户名、密码、PUBLIC_BASE_URL通过管理员邮件配置保存。
# 生产须使用受信主机、TLS及HTTPS入口，并在独立部署流程中配置。
# 不要在这里添加应用没有读取的SMTP_PASSWORD等无效占位变量。

# ---------- 语义检索（T20） ----------
# 容器内部Milvus地址；只允许本项目受信服务，部署时不要公开SDK端口。
TALENT_MILVUS_URI=http://milvus:19530
# 召回候选上限1～1000；MySQL复验后最多返回page_size。
TALENT_SEMANTIC_TOP_K=200
# 余弦相关度阈值-1～1，不是岗位匹配分；不乘100。
TALENT_SEMANTIC_MIN_RELEVANCE=0.0
